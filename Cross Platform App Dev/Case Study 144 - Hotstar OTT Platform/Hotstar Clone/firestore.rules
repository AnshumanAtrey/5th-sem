rules_version = '2';

// The server-side copy of the client's validation. Anyone can call the
// Firestore API directly, so these rules are the real gatekeeper; the
// Flutter forms only make it friendly.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function myEmail() { return request.auth.token.email; }

    // ---- Profiles: plan, family, parental settings -------------------------
    match /users/{uid} {
      function validProfile(d) {
        return d.displayName is string && d.displayName.size() <= 60
          && d.plan in ['free', 'mobile', 'super', 'premium']
          && d.get('familyEmails', []) is list
          && d.get('familyEmails', []).size() <= 3
          && (d.plan == 'premium' || d.get('familyEmails', []).size() == 0);
      }

      // Family members may read the owner's doc, to see that they're covered.
      allow read: if isUser(uid)
        || (signedIn() && myEmail() in resource.data.get('familyEmails', []));
      // DEMO GAP: the owner can write their own `plan` (mock checkout). In
      // production, only a payment webhook (Admin SDK) would set `plan`:
      //   && request.resource.data.plan == resource.data.plan
      allow create, update: if isUser(uid) && validProfile(request.resource.data);
      allow delete: if false;

      match /progress/{contentId} {
        allow read, delete: if isUser(uid);
        allow write: if isUser(uid)
          && request.resource.data.contentId == contentId
          && request.resource.data.positionMs is int && request.resource.data.positionMs >= 0
          && request.resource.data.durationMs is int && request.resource.data.durationMs >= 0;
      }
    }

    // ---- Reviews: one per user per title (doc id = uid) --------------------
    match /titles/{contentId}/reviews/{reviewUid} {
      allow read: if signedIn();
      allow create, update: if isUser(reviewUid)
        && request.resource.data.uid == reviewUid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 500
        && request.resource.data.spoiler is bool
        && request.resource.data.author is string && request.resource.data.author.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if isUser(reviewUid);
    }

    // ---- Live chat & reactions: append-only -------------------------------
    match /live/{channelId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.sentAt == request.time;
      allow update, delete: if false;
    }

    match /live/{channelId}/reactions/{reactionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emoji in ['🔥', '👏', '😂', '😮', '❤️', '🏏']
        && request.resource.data.sentAt == request.time;
      allow update, delete: if false;
    }
  }
}
